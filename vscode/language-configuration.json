{
	"comments": {
		"lineComment": "--",
		"blockComment": ["--[[", "]]"]
	},
	"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "'", "close": "'", "notIn": ["string"] },
		{ "open": "`", "close": "`", "notIn": ["string"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"],
		["`", "`"]
	],
	"indentationRules": {
		"increaseIndentPattern": "^(?!\\s*(?:export\\s+|global\\s+)?(?:declare|remote)\\s+function\\b)(?:(?:[^-]|-(?!-))*(?:\\b(?:then|do|repeat|else|with|as)\\b|[\\{\\[\\(])|\\s*default|(?:[^-]|-(?!-))*\\b(?:function|macro)\\b(?!(?:[^-]|-(?!-))*\\bend\\b)(?:[^-]|-(?!-))*\\)(?:\\s*(?:->|:)\\s*\\S.*)?)\\s*(?:--.*)?$",
		"decreaseIndentPattern": "^\\s*(?:(?:end|else|elseif|until)\\b|[\\}\\]\\)])"
	},
	"folding": {
		"markers": {
			"start": "^\\s*--\\s*#?region\\b",
			"end": "^\\s*--\\s*#?endregion\\b"
		}
	}
}
