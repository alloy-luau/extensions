{
	"comments": {
		"lineComment": "--",
		"blockComment": ["--[[", "]]"]
	},
	"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] },
		{ "open": "`", "close": "`", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"],
		["`", "`"]
	],
	"indentationRules": {
		"increaseIndentPattern": "(?:^(?!\\s*(?:export\\s+|global\\s+)?(?:declare|remote)\\s+function\\b)(?:(?:[^-]|-(?!-))*(?:\\b(?:then|do|repeat|else|with|as)\\b|[\\{\\(]|\\[(?<!(?<!\\$map|\\$set)\\[=*\\[))|\\s*default|(?:[^-]|-(?!-))*\\b(?:function|macro(?=[ \\t]+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_]))\\b(?!(?:[^-]|-(?!-))*\\bend\\b)(?:[^-]|-(?!-))*\\)(?:\\s*(?:->|:)\\s*\\S.*)?)\\s*(?:--.*)?$)|^\\s*(?:@[A-Za-z_][\\w.]*(?:\\((?:[^()]|\\([^()]*\\))*\\))?\\s+)*(?:(?:export(?:\\s+default)?|global|public|private|declare)\\s+)?(?:struct|enum|interface|trait|impl|namespace|class)\\s+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_][\\w.]*\\s*(?:<(?:[^<>]|<(?:[^<>]|<(?:[^<>]|<[^<>]*>)*>)*>)*>)?(?:(?!\\bend\\b|=|--).)*(?:--.*)?$",
		"decreaseIndentPattern": "^\\s*(?:(?:end|else|elseif|until)\\b|[\\}\\]\\)])"
	},
	"folding": {
		"markers": {
			"start": "^\\s*--\\s*#?region\\b",
			"end": "^\\s*--\\s*#?endregion\\b"
		}
	}
}
