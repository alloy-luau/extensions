{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Alloy",
	"scopeName": "source.aly",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#string"
		},
		{
			"include": "#number"
		},
		{
			"include": "#attribute"
		},
		{
			"include": "#enum-body"
		},
		{
			"include": "#type-position"
		},
		{
			"include": "#declaration"
		},
		{
			"include": "#remote"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#macro-call"
		},
		{
			"include": "#operator"
		},
		{
			"include": "#library"
		},
		{
			"include": "#std"
		},
		{
			"include": "#call"
		},
		{
			"include": "#identifier"
		}
	],
	"repository": {
		"comment": {
			"patterns": [
				{
					"comment": "--!strict and the --@alloy- directives: the name reads as a keyword, the rest as a comment",
					"name": "comment.line.directive.aly",
					"match": "(--(?:!\\w+|@alloy-[a-z-]+))(.*)$",
					"captures": {
						"1": {
							"name": "keyword.control.directive.aly"
						}
					}
				},
				{
					"name": "comment.block.aly",
					"begin": "--\\[(=*)\\[",
					"end": "\\]\\1\\]"
				},
				{
					"name": "comment.line.double-dash.aly",
					"match": "--.*$"
				}
			]
		},
		"string": {
			"patterns": [
				{
					"name": "string.quoted.double.aly",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"include": "#escape"
						}
					]
				},
				{
					"name": "string.quoted.single.aly",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"include": "#escape"
						}
					]
				},
				{
					"name": "string.interpolated.aly",
					"begin": "`",
					"end": "`",
					"patterns": [
						{
							"include": "#escape"
						},
						{
							"name": "meta.template.expression.aly",
							"begin": "\\{",
							"end": "\\}",
							"patterns": [
								{
									"include": "$self"
								}
							]
						}
					]
				},
				{
					"comment": "A long string is Luau's, `[[ ... ]]` or `[=[ ... ]=]`. After `$map` or `$set` the brackets open the pairs.",
					"name": "string.quoted.other.multiline.aly",
					"begin": "(?<!\\$map|\\$set)\\[(=*)\\[",
					"end": "\\]\\1\\]"
				}
			]
		},
		"escape": {
			"name": "constant.character.escape.aly",
			"match": "\\\\(?:[abfnrtvz\\\\\"'`\\n{]|x[0-9A-Fa-f]{2}|\\d{1,3}|u\\{[0-9A-Fa-f]+\\})"
		},
		"number": {
			"name": "constant.numeric.aly",
			"match": "(?:\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?\\d+)?)|(?<![\\w.])\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?)i?\\b"
		},
		"attribute": {
			"comment": "@derive(...), @test, @unreliable, @ratelimit(...), @u8, and upstream @native. An import list writes an attribute the same way, `import { @tagged as t } from \"./m\"`, so the sigil and the name colour there too; the local name after `as` takes no sigil. A namespaced attribute carries its path, `@testing.testatr`, so the whole path colours as the name. The rule carries its own argument list: an enum or struct body has no string rule, so `@icon(\"x\")` on a variant needs one here.",
			"patterns": [
				{
					"begin": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\()",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.attribute.aly"
						},
						"2": {
							"name": "entity.other.attribute-name.aly"
						},
						"3": {
							"name": "punctuation.definition.arguments.begin.aly"
						}
					},
					"end": "(\\))",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.arguments.end.aly"
						}
					},
					"name": "meta.attribute.arguments.aly",
					"patterns": [
						{
							"include": "#attribute-arguments"
						}
					]
				},
				{
					"match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
					"captures": {
						"1": {
							"name": "punctuation.definition.attribute.aly"
						},
						"2": {
							"name": "entity.other.attribute-name.aly"
						}
					}
				}
			]
		},
		"declaration": {
			"patterns": [
				{
					"comment": "attribute name(...) on target, target. The word is a keyword only before a name on its line, so `local attribute = 1` keeps the name.",
					"match": "(?<![.:])\\b(?:(export)\\s+)?(attribute)[ \\t]+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.aly"
						},
						"2": {
							"name": "storage.type.aly"
						},
						"3": {
							"name": "entity.other.attribute-name.aly"
						}
					}
				},
				{
					"comment": "on target, target: the targets colour as constants and each comma as a separator. The header's `as` stays a keyword.",
					"begin": "\\b(on)\\b(?=\\s+(?:function|struct|enum|variant|field|param|remote|interface|type|local|namespace|impl|trait)\\b)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.aly"
						}
					},
					"end": "(?=\\s*(?:$|--|\\brequires\\b|\\bas\\b))",
					"name": "meta.attribute.targets.aly",
					"patterns": [
						{
							"match": "\\b(?:function|struct|enum|variant|field|param|remote|interface|type|local|namespace|impl|trait)\\b",
							"name": "constant.language.attribute-target.aly"
						},
						{
							"match": ",",
							"name": "punctuation.separator.attribute-target.aly"
						}
					]
				},
				{
					"comment": "requires <visibility>? <kind> <each>? <name>: one clause of an attribute contract. `local requires = 1` and `requires(f)` are a local named requires",
					"match": "(?<![.:])\\b(requires)[ \\t]+(?:(public|private)[ \\t]+)?(function|field)[ \\t]+(?:(each)[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.control.requires.aly"
						},
						"2": {
							"name": "storage.modifier.aly"
						},
						"3": {
							"name": "storage.type.aly"
						},
						"4": {
							"name": "keyword.control.each.aly"
						},
						"5": {
							"name": "entity.name.function.aly"
						}
					}
				},
				{
					"comment": "struct Name<T> as, enum Name as, trait Name, interface Name [extends A, B] as",
					"match": "(?<![.:])\\b(struct|enum|trait|interface)[ \\t]+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)([A-Za-z_][A-Za-z0-9_]*)(\\s*<(?:[^<>]|<(?:[^<>]|<(?:[^<>]|<[^<>]*>)*>)*>)*>)?",
					"captures": {
						"1": {
							"name": "storage.type.aly"
						},
						"2": {
							"name": "entity.name.type.aly"
						},
						"3": {
							"name": "meta.type.generics.aly",
							"patterns": [
								{
									"include": "#type-content"
								}
							]
						}
					}
				},
				{
					"comment": "namespace Name, with or without `as`. `local namespace = ns` keeps the name.",
					"match": "(?<![.:])\\b(namespace)[ \\t]+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.aly"
						},
						"2": {
							"name": "entity.name.namespace.aly"
						}
					}
				},
				{
					"comment": "macro name(. `macro(1)` and `print(macro)` use a name.",
					"match": "(?<![.:])\\b(macro)[ \\t]+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.aly"
						},
						"2": {
							"name": "entity.name.function.macro.aly"
						}
					}
				},
				{
					"comment": "type Name, type function Name",
					"match": "\\b(type)\\s+(?:(function)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.aly"
						},
						"2": {
							"name": "storage.type.aly"
						},
						"3": {
							"name": "entity.name.type.declaration.aly"
						}
					}
				},
				{
					"comment": "read x: T, write x: T field modifiers",
					"match": "\\b(read|write)\\s+(?=[A-Za-z_][A-Za-z0-9_]*\\s*:)",
					"captures": {
						"1": {
							"name": "storage.modifier.aly"
						}
					}
				},
				{
					"comment": "read T[] and write T[] in type position",
					"match": "\\b(read|write)\\s+(?=[A-Za-z_{(])",
					"captures": {
						"1": {
							"name": "storage.modifier.aly"
						}
					}
				},
				{
					"comment": "function name, local function name, async function name",
					"match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_.:]*)",
					"captures": {
						"1": {
							"name": "storage.type.aly"
						},
						"2": {
							"name": "entity.name.function.aly"
						}
					}
				}
			]
		},
		"remote": {
			"patterns": [
				{
					"comment": "remote Name(...) from client, remote function Name(...) from server. `local remote = folder.Hit` and `remote:FireServer()` keep the name.",
					"match": "(?<![.:])\\b(remote)[ \\t]+(?:(function)[ \\t]+)?(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.remote.aly"
						},
						"2": {
							"name": "storage.type.aly"
						},
						"3": {
							"name": "entity.name.function.remote.aly"
						}
					}
				},
				{
					"match": "\\b(from)\\s+(client|server)(?:\\s+(or)\\s+(client|server))?\\b",
					"captures": {
						"1": {
							"name": "keyword.control.aly"
						},
						"2": {
							"name": "constant.language.remote-side.aly"
						},
						"3": {
							"name": "keyword.operator.wordlike.aly"
						},
						"4": {
							"name": "constant.language.remote-side.aly"
						}
					}
				}
			]
		},
		"keyword": {
			"patterns": [
				{
					"comment": "`open namespace` and `export global`; a local named open or global stays a name",
					"name": "storage.modifier.aly",
					"match": "(?<![.:])\\b(?:open(?=\\s+namespace\\b)|global(?=\\s+[A-Za-z_]))\\b"
				},
				{
					"comment": "read x: T and write x: T on a field or in a type",
					"name": "storage.modifier.aly",
					"match": "\\b(?:read|write)\\b(?=\\s+[A-Za-z_({\\[])"
				},
				{
					"comment": "private and public before a name or `function` on the same line. `local private = {}` and `if public then` keep the name.",
					"name": "storage.modifier.aly",
					"match": "(?<![.:])\\b(?:private|public)\\b(?=[ \\t]+(?:function\\b|(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_]))"
				},
				{
					"name": "keyword.control.aly",
					"match": "\\b(?:if|then|elseif|else|end|for|in|while|do|repeat|until|return|break|continue|with|as|case|default|where)\\b"
				},
				{
					"comment": "`trait`, `impl`, `remote`, `macro`, `attribute`, and `namespace` are keywords only before a name, so the declaration rules colour them and this list leaves them out.",
					"name": "storage.type.aly",
					"match": "\\b(?:local|function|extends|type|from|declare|extern|class)\\b"
				},
				{
					"name": "keyword.operator.wordlike.aly",
					"match": "\\b(?:and|or|not)\\b"
				},
				{
					"name": "keyword.other.bitwise.aly",
					"match": "\\b(?:band|bor|bxor|bnot|shl|shr)\\b(?=\\s+(?![=,)\\]}]))"
				},
				{
					"name": "keyword.other.satisfies.aly",
					"match": "\\bsatisfies\\b"
				},
				{
					"comment": "new is a constructor before a type name; `new(x)`, `new.f`, `new = 1`, and `new \"s\"` are a local named new",
					"name": "keyword.operator.new.aly",
					"match": "(?<![.:])\\bnew\\b(?=[ \\t]+(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_])"
				},
				{
					"comment": "try takes an operand or a do block; `try(f)`, `try = 1`, and `try.f` are a local named try",
					"name": "keyword.control.aly",
					"match": "(?<![.:])\\btry\\b(?=[ \\t]+(?:do\\b|(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_$#]|[0-9]|-[^-]))"
				},
				{
					"comment": "match opens a match; `match(s, p)`, `match[k]`, `match = 1`, and `match.f` are a local named match",
					"name": "keyword.control.aly",
					"match": "(?<![.:])\\bmatch\\b(?=[ \\t]+(?:(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_${\\[]|[0-9]|#|-[^-]))"
				},
				{
					"comment": "const declares; `const = 1`, `const(x)`, `const[k]`, and `const.f` are a local named const",
					"name": "storage.type.aly",
					"match": "(?<![.:])\\bconst\\b(?=[ \\t]+(?:function\\b|async[ \\t]+function\\b|@|[A-Za-z_]|\\[|\\{))"
				},
				{
					"comment": "export opens a declaration or an export list; `export = t`, `export(x)`, and `export.f` are a local named export",
					"name": "storage.type.aly",
					"match": "(?<![.:])\\bexport\\b(?=[ \\t]*\\{|[ \\t]+(?:type|default|local|const|function|class|open|async|enum|struct|trait|interface|remote|attribute|macro|namespace|impl)\\b)"
				},
				{
					"comment": "async is the modifier before function or do; `local async = false` and `async(x)` are a local named async",
					"name": "storage.type.aly",
					"match": "(?<![.:])\\basync\\b(?=[ \\t]+(?:function|do)\\b)"
				},
				{
					"comment": "await takes an operand; `await(p)`, `await = f`, and `await.f` are a local named await",
					"name": "keyword.control.aly",
					"match": "(?<![.:])\\bawait\\b(?=[ \\t]+(?:(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_$#]|[0-9]|-[^-]))"
				},
				{
					"comment": "import opens the statement, and import(...) is its expression form; `local import = {}` and `import.cache` are a local named import",
					"name": "storage.type.aly",
					"match": "(?<![.:])\\bimport\\b(?=[ \\t]*(?:\\(|<<|\\*|\\{)|[ \\t]+(?:type[ \\t]*\\{|(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_]))"
				},
				{
					"name": "keyword.operator.expression.delete.aly",
					"match": "^\\s*\\b(?:delete|destroy)\\b(?=\\s+[A-Za-z_])|(?<=\\bend\\s|\\bthen\\s|\\bdo\\s|\\belse\\s)\\b(?:delete|destroy)\\b(?=\\s+[A-Za-z_])"
				},
				{
					"comment": "after opens a timed block and follows the operand of a destroy, both before a delay; `after = 1`, `after(x)`, and `after.f` are a local named after",
					"name": "keyword.control.after.aly",
					"match": "(?<![.:])\\bafter\\b(?=[ \\t]+(?:(?!(?:end|then|else|elseif|do|until|and|or|not|in|is|as|satisfies|where|return|local|const|break|continue|with|from|band|bor|bxor|shl|shr)\\b)[A-Za-z_(#]|[0-9]))"
				},
				{
					"name": "keyword.operator.type.aly",
					"match": "\\b(?:keyof|typeof|rawget|index|setmetatable)\\b(?=\\s*<)"
				},
				{
					"name": "constant.language.aly",
					"match": "\\b(?:nil|true|false)\\b"
				},
				{
					"name": "variable.language.self.aly",
					"match": "\\bself\\b"
				},
				{
					"name": "variable.language.wildcard.aly",
					"match": "\\b_\\b"
				}
			]
		},
		"macro-call": {
			"comment": "$name( and $Module.name( are macro calls, and $set[ is the bracket form; intrinsics carry a .intrinsic suffix on the same scope so they color alike by default",
			"patterns": [
				{
					"match": "(\\$)(dbg|expect|todo|unreachable|assert|assert_eq|nameof|stringify|matches|bnot|set|map)\\b(?=[\\(\\[])",
					"captures": {
						"1": {
							"name": "punctuation.definition.macro.aly"
						},
						"2": {
							"name": "entity.name.function.macro.intrinsic.aly"
						}
					}
				},
				{
					"match": "(\\$)([A-Za-z_][A-Za-z0-9_.]*)(?=[\\(\\[])",
					"captures": {
						"1": {
							"name": "punctuation.definition.macro.aly"
						},
						"2": {
							"name": "entity.name.function.macro.aly"
						}
					}
				}
			]
		},
		"operator": {
			"patterns": [
				{
					"name": "keyword.operator.safe-access.aly",
					"match": "\\?\\?=|\\?\\?|\\?\\.|\\?:|\\?\\[|\\?\\(|->(?=\\s*[A-Za-z_\"'`\\[])|=>(?=\\s*[A-Za-z_\"'`\\[])"
				},
				{
					"name": "keyword.operator.non-nil.aly",
					"match": "!(?!=)"
				},
				{
					"name": "keyword.operator.spread.aly",
					"match": "\\.\\.\\.(?=[A-Za-z_(])"
				},
				{
					"name": "keyword.operator.return-type.aly",
					"match": "->"
				},
				{
					"name": "keyword.operator.aly",
					"match": "==|~=|<=|>=|<<|>>|<|>|\\+=|-=|\\*=|/=|//=|%=|\\^=|\\.\\.=|::|\\.\\.\\.|\\.\\.|[+\\-*/%^#=|&]"
				},
				{
					"name": "punctuation.definition.array.aly",
					"match": "\\[(?!=+\\[)|\\]"
				}
			]
		},
		"std": {
			"name": "support.class.std.aly",
			"match": "\\b(?:Future|Result|Ok|Err|Array|HashMap|Set|Symbol|Attributes|Heap|Iter|Queue|Signal|Scope|Sink|Partial|Readonly|ReadArray|WriteArray|Traits)\\b"
		},
		"call": {
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=[({\"'`])",
			"captures": {
				"1": {
					"name": "entity.name.function.aly"
				}
			}
		},
		"identifier": {
			"patterns": [
				{
					"comment": "a name after ., :, ?., ?:, ?/, or :/ is a property or method, whatever its case; the right operand of .. and / is not",
					"name": "variable.other.property.aly",
					"match": "(?:(?<=[^.]\\.)|(?<=^\\.)|(?<=:)|(?<=[?:]/))[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*[({\"'`])"
				},
				{
					"name": "entity.name.type.aly",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				},
				{
					"name": "variable.other.aly",
					"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
				}
			]
		},
		"type-content": {
			"patterns": [
				{
					"name": "storage.modifier.aly",
					"match": "\\b(?:read|write)\\b(?=\\s+[A-Za-z_({\\[])"
				},
				{
					"include": "#comment"
				},
				{
					"include": "#string"
				},
				{
